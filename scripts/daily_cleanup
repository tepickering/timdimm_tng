#!/bin/bash
#
# Nightly cleanup. Measure the single exposures taken before each seeing measurement, fold the
# results into the running table, then delete the frames that were measured. Everything worth
# keeping about a frame ends up in the table, so the frames themselves do not need archiving.

set -euo pipefail

PICTURES=/home/timdimm/Pictures
TABLE=$HOME/analyze_pictures.ecsv
CACHE=$HOME/.analyze_pictures_cache

# snapshot the frames that exist right now, so anything written while the analysis runs is left
# alone and picked up by the next cleanup rather than deleted unmeasured
FRAMES=$(mktemp)
trap 'rm -f "$FRAMES"' EXIT
find "$PICTURES" -name "*.fits" -print0 > "$FRAMES"

if [ ! -s "$FRAMES" ]; then
    echo "no new frames under $PICTURES"
    exit 0
fi

# the cache holds one row per frame and is kept between runs: it makes an interrupted run
# resumable, and stops frames that survive a cleanup from being reanalyzed every night. Only the
# frames measured tonight are read back out of it, so the collect step stays proportional to the
# night rather than to the whole archive.
analyze_pictures --root "$PICTURES" --all -o "$TABLE" --cache-dir "$CACHE" --append --jobs 4

# set -e means we only get here if the measurements made it into $TABLE
xargs -0 rm -f < "$FRAMES"
