#!/bin/bash

export PATH=$HOME/conda/envs/timdimm/bin:$HOME/conda/condabin:$HOME/timdimm_tng/scripts:$PATH
export CONDA_PREFIX=$HOME/conda/envs/timdimm
export CONDA_DEFAULT_ENV=timdimm

repo_dir="${TIMDIMM_REPO_DIR:-$HOME/timdimm_tng}"
lock_dir="${XDG_RUNTIME_DIR:-$HOME/.cache/timdimm}"
watchdog_interval="${KSTARS_WATCHDOG_INTERVAL:-10}"

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    echo "kstars watchdog requires an inherited X11 or Wayland session" >&2
    exit 1
fi

cd "$repo_dir" || exit 1
mkdir -p "$lock_dir"

exec 9> "$lock_dir/kstars-watchdog.lock"
if ! flock -n 9; then
    exit 0
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] kstars watchdog started"

while true; do
    sleep "$watchdog_interval"

    if pgrep -x kstars > /dev/null; then
        continue
    fi

    echo "[$(date '+%Y-%m-%d %H:%M:%S')] kstars not running; killing indiserver and restarting kstars"

    pkill -x indiserver || true
    sleep 2
    pkill -9 -x indiserver || true

    KSTARS_WATCHDOG=0 "$repo_dir/scripts/start_kstars"
done
