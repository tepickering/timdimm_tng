#!/usr/bin/env python
"""
Plot the prism/clear throughput history: the SER cube survey alongside the single-exposure archive.

Reads `throughput_pooled.ecsv` (from scripts/prism_throughput, pooled across machines) and
`analyze_pictures.ecsv`, and writes throughput_history.png beside them.

The point of drawing both on one axis is that they cross: the SER series ends in December 2024, so
the settling floor is extrapolated across the whole period the single exposures cover, and over that
period the single exposures are still falling. See docs/archive_notes.md.
"""

from pathlib import Path

import matplotlib
import numpy as np
from astropy.table import Table
from astropy.time import Time
from scipy.optimize import curve_fit

# this only ever writes a file, and the observing machines have no display
matplotlib.use("Agg")

import matplotlib.pyplot as plt  # noqa: E402 -- must follow the backend selection above

ROOT = Path.home() / "SAAO/timdimm_data"
OUT = ROOT / "throughput_history.png"
# the data lives outside the repo, but the figure is what docs/archive_notes.md argues from, so a
# copy is kept beside the notes
DOCS = Path(__file__).resolve().parent.parent / "docs" / "throughput_history.png"

# ---- SER cube survey -------------------------------------------------------------------------
u = Table.read(ROOT / "throughput_pooled.ecsv")
good = (np.array([str(s).startswith("ok") for s in u["status"]]) & (u["used"] >= 150)
        & (u["sep_pix"] > 5) & (u["scint"] < 5) & np.isfinite(u["thr_r11"])
        & np.array([str(d) != "unknown" for d in u["date"]]))
ser = u[good & (u["width"] <= 1000)]
full = u[good & (u["width"] > 1000)]

dates = sorted(set(str(d) for d in ser["date"]))
sx = Time(dates).decimalyear
sn = np.array([int(sum(str(z) == d for z in ser["date"])) for d in dates], float)
sy = np.array([float(np.median(ser["thr_r11"][[str(z) == d for z in ser["date"]]])) for d in dates])
# spread of the night, not of the mean: shows how much a single cube can miss by
slo = np.array([float(np.percentile(ser["thr_r11"][[str(z) == d for z in ser["date"]]], 16))
                for d in dates])
shi = np.array([float(np.percentile(ser["thr_r11"][[str(z) == d for z in ser["date"]]], 84))
                for d in dates])

t0 = sx[0]
p, cov = curve_fit(lambda t, c, a, tau: c + a * np.exp(-(t - t0) / tau), sx, sy,
                   p0=[0.70, 0.25, 0.4], sigma=1 / np.sqrt(sn), maxfev=40000)
perr = np.sqrt(np.diag(cov))

# ---- single-exposure archive ------------------------------------------------------------------
pic = Table.read(ROOT / "analyze_pictures.ecsv")
night = np.array([str(d)[:10] for d in pic["date_obs"]])
f0, f1 = np.asarray(pic["star0_flux"], float), np.asarray(pic["star1_flux"], float)
usable = np.isfinite(f0) & np.isfinite(f1) & (f0 > 0) & (f1 > 0)

px, py, plo, phi, psem, pn = [], [], [], [], [], []
for d in sorted(set(night)):
    m = usable & (night == d)
    if m.sum() < 30:
        continue
    a, b = np.median(f0[m]), np.median(f1[m])
    # star0/star1 are x-sorted labels and the camera rotation swaps them, so identify the prism
    # aperture per night by which is fainter rather than trusting the label. Fix that choice for
    # the whole night: taking min/max frame by frame would let noise bias the ratio downward.
    num, den = (f0[m], f1[m]) if a < b else (f1[m], f0[m])
    r = num / den
    px.append(Time(d).decimalyear)
    py.append(float(np.median(r)))
    plo.append(float(np.percentile(r, 16)))
    phi.append(float(np.percentile(r, 84)))
    # robust standard error on the night's median: how well the night itself is pinned down
    psem.append(float(1.4826 * np.median(np.abs(r - np.median(r))) / np.sqrt(m.sum())))
    pn.append(int(m.sum()))
px, py, plo, phi, psem = (np.array(v) for v in (px, py, plo, phi, psem))

# ---- plot ------------------------------------------------------------------------------------
# the frame-to-frame spread within a night is ~0.37, twenty times the standard error on the nightly
# median, so it is deliberately not drawn: it floods the axis and says nothing about the trend. The
# numbers are printed at the end instead.
fig, ax = plt.subplots(figsize=(12, 6.5))

ax.scatter(Time([str(d) for d in ser["date"]]).decimalyear, ser["thr_r11"], s=9, alpha=0.25,
           color="#1f77b4", edgecolors="none", label="SER cubes, individual (n=%d)" % len(ser), zorder=2)
ax.errorbar(sx, sy, yerr=[sy - slo, shi - sy], fmt="o", ms=7, color="#1f77b4", capsize=3, lw=1.2,
            mec="white", mew=0.8, label="SER cubes, nightly median (16-84%)", zorder=4)

ax.errorbar(px, py, yerr=psem, fmt="o", ms=3.5, color="#d62728", ecolor="#d62728", capsize=1.5,
            lw=1.0, alpha=0.75, zorder=3,
            label="single exposures, nightly median $\\pm$ s.e. (%d nights)" % len(px))

ax.scatter(Time([str(d) for d in full["date"]]).decimalyear, full["thr_r11"], s=55, marker="x",
           color="#7f7f7f", lw=1.6, label="full-frame cubes (saturated, excluded)", zorder=5)

grid = np.linspace(sx.min(), 2026.75, 400)

# a single straight line through every nightly median from both datasets. Its residual rms is the
# same as the night-to-night scatter of the single exposures alone, so the data give no reason to
# ask for anything more elaborate.
allx, ally = np.concatenate([sx, px]), np.concatenate([sy, py])
alin = np.polyfit(allx, ally, 1)
ares = ally - np.polyval(alin, allx)
ase = ares.std() / (np.sqrt(len(allx)) * allx.std())
ax.plot(grid, np.polyval(alin, grid), color="#111111", lw=2.2, zorder=7,
        label="single line, both datasets (%.3f $\\pm$ %.3f /yr, rms %.3f)" % (alin[0], ase, ares.std()))

# the exponential is kept only to show that it is not needed: on the SER nightly medians it beats a
# straight line by an rms of 0.008, an order of magnitude below the 0.082 night-to-night scatter
serlin = np.polyfit(sx, sy, 1)
gain = np.std(sy - np.polyval(serlin, sx)) - np.std(sy - (p[0] + p[1] * np.exp(-(sx - t0) / p[2])))
ax.plot(grid, p[0] + p[1] * np.exp(-(grid - t0) / p[2]), color="#2ca02c", ls="--", lw=1.3,
        alpha=0.65, zorder=5,
        label="settling curve (fits SER by only %.3f rms better; not resolvable)" % gain)

for when, what in (("2025-10-30", "camera reconfig"), ("2026-02-19", "USB cable, camera rotated"),
                   ("2026-04-09", "reassembled after mount failure")):
    x = Time(when).decimalyear
    ax.axvline(x, color="k", lw=0.8, ls="-", alpha=0.25, zorder=1)
    ax.text(x, 1.045, " " + what, rotation=90, va="top", ha="left", fontsize=7.5, alpha=0.65)

ax.set_xlabel("year")
ax.set_ylabel("throughput, prism aperture / clear aperture")
ax.set_title("timDIMM prism throughput since the ASI432MM was commissioned\n"
             "night-to-night scatter swamps any curvature: a single linear decline is as much as "
             "the data support", fontsize=11)
ax.set_ylim(0.20, 1.06)
ax.set_xlim(2023.35, 2026.8)
ax.grid(alpha=0.25, lw=0.6)
ax.legend(loc="lower left", fontsize=8.5, framealpha=0.93)

fig.tight_layout()
fig.savefig(OUT, dpi=140)
fig.savefig(DOCS, dpi=140)
print("wrote", OUT, "and", DOCS)
print(f"single line, both datasets: {alin[0]:+.4f}+-{ase:.4f}/yr, residual rms {ares.std():.4f}")
plin = np.polyfit(px, py, 1)
print(f"single exposures alone: {plin[0]:+.4f}/yr over {len(px)} nights, "
      f"scatter about it {np.std(py - np.polyval(plin, px)):.4f}")
print(f"SER alone: {serlin[0]:+.4f}/yr over {len(sx)} nights")
print(f"typical s.e. on a nightly median {np.median(psem):.4f}, "
      f"frame-to-frame half-width {np.median((phi - plo) / 2):.3f}")
print(f"exponential beats a line on the SER data by rms {gain:.4f} (floor {p[0]:.3f}"
      f"+-{perr[0]:.3f}, tau {p[2]*12:.1f} months)")
